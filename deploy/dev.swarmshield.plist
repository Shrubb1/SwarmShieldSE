<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.swarmshield</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/swarmshield</string>
        <string>9101:8081</string>
        <string>-q</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/swarmshield.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/swarmshield.log</string>
</dict>
</plist>
